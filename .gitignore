__pycache__/
*.py[cod]
*$py.class
*.log
*.tmp
*.zip
putty/
# scratch test scripts in the repo root only (cleanup.sh removes these);
# the real suite lives in tests/ and must stay tracked
/test*.py
*.sh~

# Exclude local virtual environment and temporary packaging artifact
venv/

# graphify local cache and run state (regenerated by `graphify update .`)
graphify-out/cache/
graphify-out/manifest.json
graphify-out/.graphify_*

# Agent worktrees and the empty Scrapling folder were committed by accident
# as gitlinks without a .gitmodules entry, which made every CI checkout warn
# ("git failed with exit code 128"). Scrapling comes from PyPI.
.claude/worktrees/
/Scrapling/

# mkdocs output and tool caches
/site/
.mypy_cache/
.ruff_cache/
